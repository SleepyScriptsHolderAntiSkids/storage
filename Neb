	CtrMode = "ue counter",
	CtrHud = true,
	CtrKiciaCycleMs = 50,
	CtrKiciaFlyMs = 25,
	CtrKiciaBoost = 100000,
	CtrKiciaBoostMs = 600,
	CtrKiciaFlySpeed = 15000,
	CtrKiciaZigAmp = 400,
	CtrKiciaZigFreq = 8,
	CtrKiciaDepth = 6,
	CtrKiciaRadius = 30,
	CtrVoidSpeed = 3000,
	CtrLegits = true,
	CtrBots = true,
	CtrMaxLegits = 1,
	CtrLegitDelay = 3,
	CtrLegitStay = 35, 
	CtrLegitGap = 50, 
	CtrLegitLead = 6,
	CtrBotStay = 35, 
	CtrBotGap = 50, 
	CtrBotLead = 6,
}

local function cfg(key, default)
	if Toggles[key] ~= nil then
		return Toggles[key].Value
	elseif Options[key] ~= nil then
		return Options[key].Value
	end
	return DEFAULTS[key] ~= nil and DEFAULTS[key] or default
end

local MODE_UE, MODE_KICIA, MODE_SOLIX = "ue counter", "Kicia counter", "Solix counter"

